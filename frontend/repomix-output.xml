            <div className="filter-chips">
              {(['ALL', 'CRITICAL', 'HIGH', 'MEDIUM', 'LOW'] as const).map((level) => (
                <button
                  key={level}
                  type="button"
                  className={`chip ${level === 'CRITICAL' ? 'c-crit' : level === 'HIGH' ? 'c-high' : level === 'MEDIUM' ? 'c-med' : level === 'LOW' ? 'c-low' : ''} ${sevFilter === level ? 'active' : ''}`}
