# SOCoPilot — copy to .env and adjust

# Application
APP_NAME=SOCoPilot
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=socopilot
POSTGRES_PASSWORD=socopilot_dev
POSTGRES_DB=socopilot

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_LLM_MODEL=mistral:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Elasticsearch (Phase 2 — disabled)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200

OPENSEARCH_ENABLED=true
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_ALERTS=socopilot-alerts
OPENSEARCH_INDEX_IOCS=socopilot-iocs

ENRICHMENT_TIMEOUT_SECONDS=15
ENRICHMENT_MAX_RETRIES=3

# Qdrant (Phase 3+)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Threat Intel (Phase 2+)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

DEDUP_TIME_BUCKET_MINUTES=15
INGEST_DEFAULT_SOURCE=webhook

# Frontend
# Leave empty for Docker (nginx proxies /api). Set http://localhost:8000 only for direct browser→API dev.
VITE_API_BASE_URL=

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=socopilot
