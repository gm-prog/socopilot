}

.mitre-card {
    display: flex;
    gap: 0;
    background: var(--bg-2);
    border: 1px solid var(--bd);
    border-radius: 3px;
    overflow: hidden
}

.mitre-half {
    flex: 1;
    padding: 8px 10px
}

.mitre-half+.mitre-half {
    border-left: 1px solid var(--bd)
}

.mitre-lbl {
    font-size: 9px;
    color: var(--t-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 3px
}

.mitre-val {
    font-size: 11px;
    font-weight: 500;
    color: #93c5fd
}

.mitre-sub {
    font-family: var(--ff-data);
    font-size: 9px;
    color: var(--t-3);
    margin-top: 2px
}

.risk-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px
}

.risk-track {
    flex: 1;
    height: 3px;
    background: var(--bg-3);
    border-radius: 2px;
    overflow: hidden
}

.risk-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.5s ease
}

.risk-label {
    font-family: var(--ff-data);
    font-size: 11px;
    font-weight: 500;
    width: 30px;
    text-align: right
}

.tl-list {
    display: flex;
    flex-direction: column;
    gap: 0
}

.tl-row {
    display: grid;
    grid-template-columns: 75px 14px 1fr;
    gap: 0 8px;
    align-items: baseline;
    padding: 4px 0;
    position: relative
}

.tl-time {
    font-family: var(--ff-data);
    font-size: 9px;
    color: var(--t-3);
    text-align: right;
    padding-top: 1px
}

.tl-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bd-3);
    border: 1px solid var(--bd-2);
    flex-shrink: 0;
    margin-top: 3px;
    justify-self: center
}

.tl-dot.active {
    background: var(--accent);
    border-color: var(--accent-bd)
}

.tl-text {
    font-size: 11px;
    color: var(--t-2);
    line-height: 1.4
}

.notes-ta {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--bd-2);
    border-radius: 3px;
    color: var(--t-1);
    font-family: var(--ff-ui);
    font-size: 11px;
    padding: 7px 9px;
    resize: none;
    height: 64px;
    outline: none;
    transition: border-color 0.15s;
    line-height: 1.4
}

.notes-ta:focus {
    border-color: var(--accent)
}

.notes-ta::placeholder {
    color: var(--t-4)
}

.notes-save {
    margin-top: 5px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px
}

.notes-save-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid var(--bd-2);
    border-radius: 4px;
    background: var(--bg-2);
    color: var(--t-2);
    font-size: 10px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.1s;
    font-family: var(--ff-ui)
}

.notes-save-btn:hover {
    color: var(--t-1);
    border-color: var(--bd-3)
}

.dp-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--t-3);
    padding: 30px;
    text-align: center
}

.dp-empty i {
    font-size: 26px;
    opacity: 0.2
}

.dp-empty-t {
    font-size: 12px;
    font-weight: 500;
    color: var(--t-2)
}

.dp-empty-s {
    font-size: 11px;
    color: var(--t-3);
    max-width: 180px;
    line-height: 1.5
}

.has-tip {
    position: relative
}

.has-tip:hover::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    color: var(--t-1);
    font-size: 10px;
    padding: 4px 8px;
    border-radius: 4px;
    white-space: nowrap;
    z-index: 100;
    pointer-events: none;
    font-family: var(--ff-ui)
}
