{
  "title": "SOCoPilot Phase 2",
  "uid": "socopilot-phase2",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "IOC Extractions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(socopilot_extraction_iocs_total[5m])", "legendFormat": "{{ioc_type}}" }]
    },
    {
      "id": 2,
      "title": "Enrichment Latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(socopilot_enrichment_latency_seconds_bucket[5m]))",
        "legendFormat": "{{provider}}"
      }]
    },
    {
      "id": 3,
      "title": "Dedup Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [{
        "expr": "rate(socopilot_dedup_hits_total[5m]) / (rate(socopilot_dedup_hits_total[5m]) + rate(socopilot_dedup_creates_total[5m]) + 0.001)"
      }]
    },
    {
      "id": 4,
      "title": "Provider Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "rate(socopilot_provider_failures_total[5m])", "legendFormat": "{{provider}}" }]
    }
  ]
}
