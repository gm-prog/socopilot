tbody tr.sel {
    background: rgba(91, 138, 240, 0.07);
    box-shadow: inset 1px 0 0 var(--accent), inset -1px 0 0 rgba(91, 138, 240, 0.15)
}

tbody tr.fresh td:first-child::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(91, 138, 240, 0.15);
    animation: rowflash 1.8s ease-out forwards;
    pointer-events: none
}

@keyframes rowflash {
    0% {
        opacity: 1
    }

    100% {
        opacity: 0
    }
}

td {
    padding: 0 10px;
    height: 37px;
    border-right: 1px solid var(--bd);
