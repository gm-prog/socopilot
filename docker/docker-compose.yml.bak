services:
  postgres:
    image: pgvector/pgvector:pg16
    volumes:
      - ./docker/init:/docker-entrypoint-initdb.d
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: password
      POSTGRES_DB: socopilot
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user -d socopilot"]
      interval: 5s
      timeout: 5s
      retries: 5

  api:
    environment:
      REDIS_HOST: redis
    build:
      context: ..
      dockerfile: docker/images/api.Dockerfile
    ports:
      - "8000:8000"
    env_file:
      - .env
    depends_on:
      postgres:
        condition: service_healthy

  redis:
    image: redis:7-alpine
  opensearch:
    image: opensearchproject/opensearch:2.11.1
  ollama:
    image: ollama/ollama:latest
  worker:
    build:
      context: ..
      dockerfile: docker/images/api.Dockerfile
    command: celery -A app.worker worker
  celery-beat:
    build:
      context: ..
      dockerfile: docker/images/api.Dockerfile
    command: celery -A app.worker beat
