<file path="frontend/src/styles/neptune-console.css">
/* Neptune-VII Console Styles */

:root {
    --void: #03060a;
    --void2: #060c12;
    --surface: #0a1520;
    --surface2: #0e1e2e;
    --glass: rgba(14, 30, 46, 0.8);
    --line: rgba(0, 200, 255, 0.08);
    --line2: rgba(0, 200, 255, 0.15);
    --cyan: #00c8ff;
    --cyan-dim: rgba(0, 200, 255, 0.4);
    --cyan-glow: rgba(0, 200, 255, 0.12);
    --teal: #00e5b4;
    --teal-dim: rgba(0, 229, 180, 0.4);
    --red: #ff4466;
    --red-glow: rgba(255, 68, 102, 0.15);
    --warn: #ffb830;
    --warn-glow: rgba(255, 184, 48, 0.12);
    --text-bright: #e8f4ff;
    --text-mid: rgba(180, 220, 255, 0.65);
    --text-dim: rgba(100, 160, 200, 0.45);
    --mono: 'Syne Mono', monospace;
    --display: 'Bebas Neue', sans-serif;
    --body: 'DM Sans', sans-serif;
}

.neptune-app {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100vh;
    overflow: hidden;
    background: var(--void);
    color: var(--text-bright);
    font-family: var(--body);
    font-size: 13px;
    margin: 0;
    padding: 0;
}

.grid-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
        linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 100% 100% at 50% 0%, black 40%, transparent 100%);
}

.noise {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
}

/* HEADER */
.neptune-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 14px 24px;
    border-bottom: 1px solid var(--line2);
    background: rgba(3, 6, 10, 0.7);
    backdrop-filter: blur(12px);
    position: relative;
    z-index: 10;
    flex-shrink: 0;
}

.neptune-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
}

.brand {
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-icon {
    width: 38px;
    height: 38px;
    border: 1px solid var(--cyan-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: var(--cyan-glow);
}

.brand-icon::before {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid rgba(0, 200, 255, 0.1);
}

.brand-icon i {
    font-size: 18px;
    color: var(--cyan);
}

.brand-name {
    font-family: var(--display);
    font-size: 22px;
    letter-spacing: 0.08em;
    color: var(--cyan);
    line-height: 1;
}

.brand-sub {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-top: 2px;
}

.brand-badge {
    font-family: var(--mono);
    font-size: 9px;
    padding: 2px 8px;
    border: 1px solid var(--cyan-dim);
    color: var(--cyan);
    background: var(--cyan-glow);
    letter-spacing: 0.1em;
    animation: blink 2s step-end infinite;
}

@keyframes blink {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.4;
    }
}

.header-stats {
    display: flex;
    gap: 28px;
    align-items: center;
}

.hstat {
    text-align: center;
}

.hstat-val {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-bright);
}

.hstat-val.ok {
    color: var(--teal);
}

.hstat-val.warn {
    color: var(--warn);
}

.hstat-label {
    font-size: 9px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 1px;
}

.hsep {
    width: 1px;
    height: 32px;
    background: var(--line2);
}

.header-time {
    text-align: right;
}

.htime {
    font-family: var(--display);
    font-size: 28px;
    letter-spacing: 0.05em;
    color: var(--text-bright);
    line-height: 1;
}

.hdate {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

/* MAIN GRID */
.main {
    display: grid;
    grid-template-columns: 180px 1fr 260px;
    overflow: hidden;
    min-height: 0;
}

/* LEFT NAV */
.left-nav {
    border-right: 1px solid var(--line2);
    background: rgba(3, 6, 10, 0.5);
    display: flex;
    flex-direction: column;
    padding: 16px 0;
    gap: 4px;
    overflow-y: auto;
}

.nav-section {
